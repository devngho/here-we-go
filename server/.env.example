APP_KEY=
# Places API (New) 를 켠 Google Maps Platform 키 (console.cloud.google.com)
GOOGLE_PLACES_KEY=
GEMINI_API_KEY=
LLM_MODEL=gemini-4-hydrogen

LLM_TIMEOUT_MS=15000
PORT=8080
# 후보의 리뷰를 Gemini 로 요약(대표 메뉴·리뷰 경향): 기다리는 시간, 요청당 새로 요약할 장소 수 (0 = 끔)
INSIGHT_TIMEOUT_MS=10000
INSIGHT_MAX_PLACES=24

# All /v1 requests: global and per-device fixed one-minute windows.
API_REQUESTS_PER_MINUTE=60
DEVICE_REQUESTS_PER_MINUTE=20
# Actual paid upstream attempts, shared by all devices and persisted in DB_PATH.
# Day/month reset at UTC boundaries. 0 blocks the corresponding provider (not unlimited).
PLACES_CALLS_PER_MINUTE=40
PLACES_CALLS_PER_DAY=100
PLACES_CALLS_PER_MONTH=1000
GEMINI_CALLS_PER_MINUTE=10
GEMINI_CALLS_PER_DAY=60
GEMINI_CALLS_PER_MONTH=500
# Preserve this database across restarts/deployments; do not use :memory: in production.
DB_PATH=data/herewego.db
