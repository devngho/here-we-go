<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Pleos NaviHelper SDK permissions (protection level: normal) -->
    <!-- getCurrentLocationInfo, getDestinationInfo, getRecentDestinationInfo, requestTrip ... -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- requestRoute, requestRouteWithWaypoints, addWaypoint ... -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <!-- requestNavigationScreen -->
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_MAP" />
    <!-- Pleos TextToSpeech SDK (protection level: normal) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!-- Pleos 음성 서비스가 없는 환경에서 쓰는 Android 기본 TTS 엔진 조회 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- 안내 중 도착 이벤트 수신용 포그라운드 서비스 + 도착 알림 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        출발 전·도착 후(주차 중)에 쓰는 앱이라 MainActivity 는 distractionOptimized 를 선언하지 않는다.
        주행 중에는 시스템이 화면을 막고, 도착 알림은 P단에 놓은 뒤 보낸다 (ParkingMonitor 참고).
    -->

    <application
        android:name=".ActivitiesApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Activities">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            내비가 전면에 있는 동안 이 앱이 동결되지 않고 NaviHelper 도착 콜백을 받도록 유지한다.
            장소 추천용이라 정해진 FGS 타입(location 등)에 맞지 않아 specialUse 로 선언.
        -->
        <service
            android:name=".trip.TripService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the navigation companion alive during an app-requested route to receive arrival events from the built-in navigation (Pleos NaviHelper) and suggest nearby activities." />
        </service>
    </application>

</manifest>
